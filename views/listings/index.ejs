<% layout("/layouts/boilerplate.ejs") %>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-3">

    <% for (let list of allListings) { %>

        <a href="/listings/<%= list._id %>" class="listing-link">

            <div class="card col">
                <img
                    src="<%= list.image.url %>"
                    class="card-img-top"
                    alt="listing_image"
                >

                <div class="card-body">
                    <p class="card-text">
                        <b><%= list.title %></b>
                        <br>
                        &#8377; <%= list.price.toLocaleString("en-IN") %>/night
                    </p>
                </div>
            </div>

        </a>

    <% } %>

</div>